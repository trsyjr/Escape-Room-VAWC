{
  "meta": {
    "campaign": "18-Day Campaign to End Violence Against Women",
    "version": "1.0.0",
    "matching": {
      "trim": true,
      "caseInsensitive": true,
      "collapseWhitespace": true
    }
  },
  "parts": {
    "part1": {
      "title": "BREAK THE SILENCE",
      "timeLimitSeconds": 900,
      "totalSteps": 8,
      "rooms": [
        {
          "room": 1,
          "name": "The Coded Journal",
          "steps": [
            {
              "id": "room1-step1",
              "prompt": "You found Luna's notebook. Decode the secret message to understand what she is trying to hide. Which red flags are revealed after decoding the message? (select all that apply)",
              "display": "Luna's Journal - Page 9\n8 5 3 8 5 3 11 19 13 25 16 8 15 14 5 5 22 5 18 25 5 22 5 14 9 14 7\n25 15 21 1 18 5 1 6 15 15 12 6 15 18 20 8 5 6 18 9 5 14 4 19 25 15 21 11 5 5 16\n5 22 5 18 25 13 15 22 5 25 15 21 13 1 11 5 8 5 20 18 1 3 11 19\n20 15 19 15 12 22 5 20 8 9 19 25 15 21 13 21 19 20 21 14 4 5 18 19 20 1 14 4 4 1 14 7 5",
              "options": [
                "Monitoring her phone",
                "Isolation from friends",
                "Controlling behaviors",
                "Loving encouragement",
                "Making her feel unsafe"
              ],
              "select": {
                "selector": "#r1choices input",
                "answerKey": [
                  "Monitoring her phone",
                  "Isolation from friends",
                  "Controlling behaviors",
                  "Making her feel unsafe"
                ]
              }
            },
            {
              "id": "room1-step2",
              "prompt": "Enter the unlock code (Hint: What you should always be when danger is near?)",
              "fields": [
                {
                  "input": "r1code",
                  "answerKey": ["alert"]
                }
              ]
            }
          ]
        },
        {
          "room": 2,
          "name": "The Torn Legal Scroll",
          "steps": [
            {
              "id": "room2-step1",
              "prompt": "Match each torn paper description to the law.",
              "matching": {
                "answerKey": {
                  "A": "RA 9262",
                  "B": "Safe Spaces Act",
                  "C": "Anti-Trafficking"
                }
              }
            },
            {
              "id": "room2-step2",
              "prompt": "Type the 4-letter acronym combining these laws:",
              "fields": [
                {
                  "input": "r2code",
                  "answerKey": ["vawc"]
                }
              ]
            }
          ]
        },
        {
          "room": 3,
          "name": "The Glitching Messages",
          "steps": [
            {
              "id": "room3",
              "prompt": "Identify the HARASSING messages. Select the dangerous ones, then take the missing letter of each harassing message to form a 4-letter word.",
              "select": {
                "selector": ".r3",
                "answerKey": ["1", "2", "3"]
              },
              "fields": [
                {
                  "input": "r3code",
                  "answerKey": ["safe"]
                }
              ]
            }
          ]
        },
        {
          "room": 4,
          "name": "The Scrambled Map",
          "steps": [
            {
              "id": "room4-step1",
              "prompt": "Follow the path N -> E -> S -> W. Choose the step for each position.",
              "matching": {
                "answerKey": {
                  "p1": "Barangay VAW Desk",
                  "p2": "Barangay Protection Order",
                  "p3": "WCPD",
                  "p4": "Social Worker"
                }
              }
            },
            {
              "id": "room4-step2",
              "prompt": "Enter the hotline you need to find help.",
              "fields": [
                {
                  "input": "r4code",
                  "answerKey": ["911"]
                }
              ]
            }
          ]
        }
      ]
    },
    "part2": {
      "title": "VOICES UNHEARD",
      "timeLimitSeconds": 900,
      "totalSteps": 8,
      "rooms": [
        {
          "room": 1,
          "name": "The Invisible Wounds",
          "steps": [
            {
              "id": "room1-step1",
              "prompt": "Not all violence leaves a bruise. Decode Luna's clue: \"I am pain without scars, hurt without shouting, control without touching. I steal confidence quietly. What am I?\"",
              "fields": [
                {
                  "input": "room1-answer",
                  "answerKey": ["emotional abuse"]
                }
              ]
            },
            {
              "id": "room1-step2",
              "prompt": "Enter the unlock code (Root Word):",
              "fields": [
                {
                  "input": "r1code",
                  "answerKey": ["emotion"]
                }
              ]
            }
          ]
        },
        {
          "room": 2,
          "name": "The Digital Trap",
          "steps": [
            {
              "id": "room2-step1",
              "prompt": "Decode the types of online harassment represented by the emoji clues.",
              "fields": [
                {
                  "input": "c1",
                  "clue": "Every evening, Luna notices notifications she never sent. Every post she likes seems to alert him. He knows where she goes online and even who she talks to.",
                  "answerKey": ["cyberstalking"]
                },
                {
                  "input": "c2",
                  "clue": "Luna suspects someone is tracking her every move on her phone - GPS, apps, messages.",
                  "answerKey": ["digital monitoring"]
                },
                {
                  "input": "c3",
                  "clue": "Luna fears that her private photos might be shared without her consent to hurt or humiliate her.",
                  "answerKey": ["revenge porn"]
                }
              ]
            },
            {
              "id": "room2-step2",
              "prompt": "Enter the platform unlock code (Platform):",
              "fields": [
                {
                  "input": "r2code",
                  "answerKey": ["online"]
                }
              ]
            }
          ]
        },
        {
          "room": 3,
          "name": "The Cipher of Control",
          "steps": [
            {
              "id": "room3",
              "prompt": "Decode the numeric cipher below (A=1, B=2 ...):",
              "display": "20 1 11 5 19 25 15 21 18 13 15 14 5 25 1 23 1 25",
              "fields": [
                {
                  "input": "r3decoded",
                  "answerKey": ["takes your money away"]
                }
              ]
            },
            {
              "id": "room3-unlock",
              "prompt": "Name the silent chain (one word):",
              "fields": [
                {
                  "input": "r3code",
                  "answerKey": ["control"]
                }
              ]
            }
          ]
        },
        {
          "room": 4,
          "name": "The Breaking Point",
          "steps": [
            {
              "id": "room4-step1",
              "prompt": "Read the first letters of each line (acrostic), then enter the 4-digit unlock code derived from the numeric lines.",
              "display": "bRave souls should act.\nEVERYONE must be vigilant.\nCareful teps are necessary.\nall signs ignored are danger.\nUse your wisdom.\nSeek help discreetly.\n\nOne brave friend\nThree signs noticed\nFour doors locked\nThree steps to safety",
              "fields": [
                {
                  "input": "r4a",
                  "answerKey": ["rescue us", "rescueus"]
                },
                {
                  "input": "r4b",
                  "answerKey": ["1343"]
                }
              ]
            },
            {
              "id": "room4-step2",
              "prompt": "Find the hidden hotline that will bring Luna to safety. Enter the hotline number.",
              "fields": [
                {
                  "input": "r4hotline",
                  "answerKey": ["911"]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
